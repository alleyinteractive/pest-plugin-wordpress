{
    "name": "alleyinteractive/pest-plugin-wordpress",
    "description": "WordPress Pest Integration",
    "keywords": [
        "php",
        "framework",
        "pest",
        "unit",
        "test",
        "testing",
        "plugin",
        "wordpress"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "mantle-framework/testkit": "^1.9",
        "pestphp/pest": "^4.0.0",
        "pestphp/pest-plugin": "^4.0.0"
    },
    "autoload": {
        "psr-4": {
            "Pest\\PestPluginWordPress\\": "src/"
        },
        "files": [
            "src/Autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pest\\PestPluginWordPress\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest-dev-tools": "^4.0",
        "szepeviktor/phpstan-wordpress": "*"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "mantle": {
            "aliases": [],
            "providers": [
              "Pest\\PestPluginWordPress\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "alleyinteractive/composer-wordpress-autoloader": true
        }
    },
    "scripts": {
        "rector": "rector",
        "lint": "pint",
        "phpstan": "phpstan --memory-limit=512M",
        "test:rector": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "@phpstan",
        "test:unit": "pest --colors=always",
        "test:watch": "npx nodemon --watch tests --exec \"composer test:unit\" -e php",
        "test": [
            "@test:rector",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
